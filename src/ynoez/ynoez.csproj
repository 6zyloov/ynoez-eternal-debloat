<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>ynoez</AssemblyName>
    <RootNamespace>ynoez</RootNamespace>
    <Version>0.3.0</Version>
    <Product>ynoez</Product>
    <Company>ynoez</Company>
    <Description>Windows tuning, diagnostics and hardware toolbox.</Description>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.15" />
    <None Update="Toolbox\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Optimization\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Remove="Assets\Fonts\*.ttf" />
    <Resource Include="Assets\Fonts\*.ttf" />
    <Content Include="Assets\Fonts\OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
