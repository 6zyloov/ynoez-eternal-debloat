<Window x:Class="ynoez.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ynoez 0.3.0" Width="1160" Height="780" MinWidth="940" MinHeight="600"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResizeWithGrip" Background="#000000" Foreground="#FFFFFF"
        FontFamily="{StaticResource AppFont}" Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid Background="#000000">
        <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="#000000" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                <TextBlock Text="ynoez" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" />
                <TextBlock Text="  /  SYSTEM CONTROL" FontSize="9" Foreground="#858585" VerticalAlignment="Center" Margin="9,2,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                <Button Content="—" Width="44" Background="Transparent" Foreground="#D2D2D2" BorderThickness="0" Click="Minimize_Click" FontSize="16" Cursor="Hand" />
                <Button Content="□" Width="44" Background="Transparent" Foreground="#D2D2D2" BorderThickness="0" Click="Maximize_Click" FontSize="13" Cursor="Hand" />
                <Button Content="×" Width="44" Background="Transparent" Foreground="#D2D2D2" BorderThickness="0" Click="Close_Click" FontSize="18" Cursor="Hand" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="218"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#000000" BorderBrush="#1D1D1D" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="142"/><RowDefinition Height="*"/><RowDefinition Height="78"/></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="24,23,18,12">
                        <TextBlock Text="ynoez" FontSize="31" FontWeight="Bold" Foreground="#FFFFFF" />
                        <TextBlock Text="PERFORMANCE TOOLBOX" FontSize="9" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="2,0,0,0" />
                        <TextBlock Text="Windows • Hardware • Network" FontSize="9" Foreground="#858585" Margin="2,9,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="8,2,8,0">
                        <TextBlock Text="MENU" FontSize="9" Foreground="#777777" Margin="13,0,0,9" FontWeight="SemiBold" />
                        <Button x:Name="NavHome" Tag="⌂" Content="Home" Style="{StaticResource NavButton}" Click="Nav_Click" />
                        <Button x:Name="NavMonitor" Tag="▣" Content="Monitor" Style="{StaticResource NavButton}" Click="Nav_Click" />
                        <Button x:Name="NavProcessFocus" Tag="⚡" Content="Foco de Jogo" Style="{StaticResource NavButton}" Click="Nav_Click" />
                        <Button x:Name="NavBackup" Tag="◫" Content="Backup" Style="{StaticResource NavButton}" Click="Nav_Click" />
                        <Button x:Name="NavTweaks" Tag="✣" Content="Tweaks" Style="{StaticResource NavButton}" Click="Nav_Click" />
                        <Button x:Name="NavNetwork" Tag="⌁" Content="Network" Style="{StaticResource NavButton}" Click="Nav_Click" />
                        <Button x:Name="NavDebloat" Tag="▦" Content="Debloat" Style="{StaticResource NavButton}" Click="Nav_Click" />
                        <Button x:Name="NavBoard" Tag="▧" Content="Motherboard" Style="{StaticResource NavButton}" Click="Nav_Click" />
                        <Button x:Name="NavToolbox" Tag="⌕" Content="Toolbox" Style="{StaticResource NavButton}" Click="Nav_Click" />
                        <Button x:Name="NavRestore" Tag="↶" Content="Restore" Style="{StaticResource NavButton}" Click="Nav_Click" />
                        <Button x:Name="NavLogs" Tag="≡" Content="Logs" Style="{StaticResource NavButton}" Click="Nav_Click" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Margin="20,4,12,10" VerticalAlignment="Bottom">
                        <Border Height="1" Background="#202020" Margin="0,0,0,10" />
                        <TextBlock Text="LOCAL MODE  •  NO TELEMETRY" FontSize="8" Foreground="#858585" />
                        <TextBlock Text="ynoez 0.3.0" FontSize="9" Foreground="#FFFFFF" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Column="1" Background="#000000">
                <Grid.RowDefinitions><RowDefinition Height="59"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#000000" BorderBrush="#1D1D1D" BorderThickness="0,0,0,1">
                    <Grid Margin="24,0,24,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="PageTitle" Text="Home" FontSize="17" FontWeight="SemiBold" Foreground="#FFFFFF" />
                            <Border Background="#151515" CornerRadius="5" Padding="8,4" Margin="12,0,0,0">
                                <TextBlock Text="LOCAL" FontSize="8" FontWeight="Bold" Foreground="#FFFFFF" />
                            </Border>
                        </StackPanel>
                        <Button Content="↻  Atualizar" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource QuietButton}" Click="Refresh_Click" Padding="12,6" FontSize="10" />
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="1" x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="#000000" Padding="24,20,24,28">
                    <ContentControl x:Name="PageHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" />
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
