<Window x:Class="ynoez.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ynoez"
        Title="ynoez 0.3.1" Width="1160" Height="780" MinWidth="900" MinHeight="580"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize"
        Background="#000000" Foreground="#FFFFFF" FontFamily="{StaticResource AppFont}"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid Background="#000000" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#000000" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                <TextBlock Text="ynoez" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" />
                <TextBlock Text=" / PERFORMANCE TUNER" FontSize="8" Foreground="#777777"
                           VerticalAlignment="Center" Margin="9,2,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="—" Width="42" Background="Transparent" Foreground="#FFFFFF"
                        BorderThickness="0" Click="Minimize_Click" FontSize="15" />
                <Button Content="□" Width="42" Background="Transparent" Foreground="#FFFFFF"
                        BorderThickness="0" Click="Maximize_Click" FontSize="12" />
                <Button Content="×" Width="42" Background="Transparent" Foreground="#FFFFFF"
                        BorderThickness="0" Click="Close_Click" FontSize="17" />
            </StackPanel>
        </Grid>

        <Grid x:Name="ApplicationShell" Grid.Row="1" Background="#000000">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="184" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="#000000">
                <Grid.RowDefinitions>
                    <RowDefinition Height="126" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="54" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="22,22,14,8">
                    <TextBlock Text="ynoez" FontSize="29" FontWeight="Bold" Foreground="#FFFFFF" />
                    <TextBlock Text="PERFORMANCE TUNER" FontSize="8" FontWeight="Bold"
                               Foreground="#FFFFFF" Margin="1,0,0,0" />
                    <TextBlock Text="Windows • Jogos • Hardware" FontSize="8"
                               Foreground="#858585" Margin="1,9,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="8,2,8,0">
                    <TextBlock Text="MENU" FontSize="8" Foreground="#666666"
                               Margin="12,0,0,8" FontWeight="Bold" />
                    <Button x:Name="NavHome" Tag="⌂" Content="Home" Style="{StaticResource NavButton}" Click="Nav_Click" />
                    <Button x:Name="NavTweaks" Tag="✣" Content="Otimizações" Style="{StaticResource NavButton}" Click="Nav_Click" />
                    <Button x:Name="NavDebloat" Tag="▦" Content="Debloat" Style="{StaticResource NavButton}" Click="Nav_Click" />
                    <Button x:Name="NavProcessFocus" Tag="⚡" Content="Foco de Jogo" Style="{StaticResource NavButton}" Click="Nav_Click" />
                    <Button x:Name="NavBoard" Tag="▧" Content="Placa-mãe" Style="{StaticResource NavButton}" Click="Nav_Click" />
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="20,0,12,10" VerticalAlignment="Bottom">
                    <TextBlock Text="LOCAL • SEM TELEMETRIA" FontSize="7" Foreground="#777777" />
                    <TextBlock Text="ynoez 0.3.1" FontSize="8" Foreground="#FFFFFF" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>

            <Grid Grid.Column="1" Background="#000000">
                <Grid.RowDefinitions>
                    <RowDefinition Height="54" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Background="#000000" Margin="24,0,24,0">
                    <TextBlock x:Name="PageTitle" Text="Home" FontSize="17" FontWeight="SemiBold"
                               Foreground="#FFFFFF" VerticalAlignment="Center" />
                </Grid>
                <ScrollViewer x:Name="PageScroll" Grid.Row="1" Background="#000000"
                              Padding="24,15,24,24" VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <ContentControl x:Name="PageHost" HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Top" />
                </ScrollViewer>
            </Grid>
        </Grid>

        <Grid x:Name="LoginOverlay" Grid.Row="1" Background="#000000" Panel.ZIndex="100">
            <Grid Margin="68,52,68,52" Background="#000000">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.9*" />
                    <ColumnDefinition Width="1.1*" />
                </Grid.ColumnDefinitions>

                <local:SigilIntro x:Name="LoginSigil" Grid.Column="0" Formed="LoginSigil_Formed" />

                <StackPanel x:Name="LoginForm" Grid.Column="1" VerticalAlignment="Center" MaxWidth="330"
                            HorizontalAlignment="Center" Opacity="0" IsHitTestVisible="False">
                    <TextBlock Text="Login" FontSize="27" FontWeight="Bold"
                               Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,24" />
                    <TextBlock Text="Usuário" FontSize="9" Foreground="#BDBDBD" Margin="0,0,0,5" />
                    <TextBox x:Name="LoginUserBox" Height="38" ToolTip="Qualquer texto será aceito" />
                    <TextBlock Text="Senha" FontSize="9" Foreground="#BDBDBD" Margin="0,14,0,5" />
                    <PasswordBox x:Name="LoginPasswordBox" />
                    <Button Content="Entrar" Style="{StaticResource AccentButton}" Height="38"
                            Margin="0,19,0,0" Click="Login_Click" />
                    <TextBlock Text="Acesso local de demonstração • qualquer entrada é aceita"
                               FontSize="8" Foreground="#666666" TextWrapping="Wrap"
                               TextAlignment="Center" Margin="0,12,0,0" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
