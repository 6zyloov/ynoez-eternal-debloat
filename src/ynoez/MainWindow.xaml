<Window x:Class="ynoez.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ynoez"
        Title="ynoez 0.3.1" Width="1141" Height="768" MinWidth="1060" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResizeWithGrip" Background="#121212" Foreground="#FFFFFF"
        FontFamily="{StaticResource AppFont}" Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid Background="#121212">
        <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="#121212" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                <TextBlock Text="ynoez" FontSize="16" FontWeight="Bold" Foreground="#FF80FF" />
                <TextBlock Text="  /  SYSTEM CONTROL" FontSize="9" Foreground="#787878" VerticalAlignment="Center" Margin="9,2,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                <Button Content="—" Width="44" Background="Transparent" Foreground="#AFAFAF" BorderThickness="0" Click="Minimize_Click" FontSize="16" Cursor="Hand" />
                <Button Content="□" Width="44" Background="Transparent" Foreground="#AFAFAF" BorderThickness="0" Click="Maximize_Click" FontSize="13" Cursor="Hand" />
                <Button Content="×" Width="44" Background="Transparent" Foreground="#AFAFAF" BorderThickness="0" Click="Close_Click" FontSize="18" Cursor="Hand" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#121212" BorderBrush="#252525" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="142"/><RowDefinition Height="*"/><RowDefinition Height="78"/></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="24,23,18,12">
                        <TextBlock Text="ynoez" FontSize="31" FontWeight="Bold" Foreground="#FFFFFF" />
                        <TextBlock Text="PERFORMANCE TOOLBOX" FontSize="9" FontWeight="SemiBold" Foreground="#FF80FF" Margin="2,0,0,0" />
                        <TextBlock Text="Windows • Hardware • Network" FontSize="9" Foreground="#787878" Margin="2,9,0,0" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="8,2,8,0">
                        <TextBlock Text="MENU" FontSize="9" Foreground="#686868" Margin="13,0,0,9" FontWeight="SemiBold" />
                        <Button x:Name="NavHome" Tag="⌂" Content="Home" Style="{StaticResource NavButton}" Click="Nav_Click" />
                        <Button x:Name="NavMonitor" Tag="▣" Content="Monitor" Style="{StaticResource NavButton}" Click="Nav_Click" />
                        <Button x:Name="NavBackup" Tag="◫" Content="Backup" Style="{StaticResource NavButton}" Click="Nav_Click" />
                        <Button x:Name="NavTweaks" Tag="✣" Content="Tweaks" Style="{StaticResource NavButton}" Click="Nav_Click" />
                        <Button x:Name="NavNetwork" Tag="⌁" Content="Network" Style="{StaticResource NavButton}" Click="Nav_Click" />
                        <Button x:Name="NavDebloat" Tag="▦" Content="Debloat" Style="{StaticResource NavButton}" Click="Nav_Click" />
                        <Button x:Name="NavBoard" Tag="▧" Content="Motherboard" Style="{StaticResource NavButton}" Click="Nav_Click" />
                        <Button x:Name="NavToolbox" Tag="⌕" Content="Toolbox" Style="{StaticResource NavButton}" Click="Nav_Click" />
                        <TextBlock Text="AÇÕES RÁPIDAS" FontSize="9" Foreground="#686868" Margin="13,14,0,7" FontWeight="SemiBold" />
                        <Button x:Name="NavQuickOptimize" Tag="⚡" Content="Otimizar agora" Style="{StaticResource NavButton}" Click="NavQuickOptimize_Click" />
                        <Button x:Name="NavQuickDebloat" Tag="✦" Content="Debloat automático" Style="{StaticResource NavButton}" Click="NavQuickDebloat_Click" />
                        <Button x:Name="NavGameFocus" Tag="🎮" Content="Foco de jogo" Style="{StaticResource NavButton}" Click="NavGameFocus_Click" />
                        <Button x:Name="NavFirmwareCompat" Tag="▧" Content="BIOS / anti-cheat" Style="{StaticResource NavButton}" Click="NavFirmwareCompat_Click" />
                        <Button x:Name="NavRestore" Tag="↶" Content="Restore" Style="{StaticResource NavButton}" Click="Nav_Click" />
                        <Button x:Name="NavLogs" Tag="≡" Content="Logs" Style="{StaticResource NavButton}" Click="Nav_Click" />
                    </StackPanel></ScrollViewer>
                    <StackPanel Grid.Row="2" Margin="20,4,12,10" VerticalAlignment="Bottom">
                        <Border Height="1" Background="#292929" Margin="0,0,0,10" />
                        <TextBlock Text="LOCAL MODE  •  NO TELEMETRY" FontSize="8" Foreground="#787878" />
                        <TextBlock Text="ynoez 0.3.1" FontSize="9" Foreground="#FF80FF" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Column="1" Background="#121212">
                <Grid.RowDefinitions><RowDefinition Height="59"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#121212" BorderBrush="#252525" BorderThickness="0,0,0,1">
                    <Grid Margin="24,0,24,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="PageTitle" Text="Home" FontSize="17" FontWeight="SemiBold" Foreground="#FFFFFF" />
                            <Border Background="#211C21" CornerRadius="5" Padding="8,4" Margin="12,0,0,0">
                                <TextBlock Text="LOCAL" FontSize="8" FontWeight="Bold" Foreground="#FF80FF" />
                            </Border>
                        </StackPanel>
                        <Button Content="↻  Atualizar" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource QuietButton}" Click="Refresh_Click" Padding="12,6" FontSize="10" />
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="1" x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="#121212" Padding="24,20,24,28">
                    <ContentControl x:Name="PageHost" />
                </ScrollViewer>
            </Grid>
        </Grid>
        <Grid x:Name="LoginOverlay" Grid.RowSpan="2" Panel.ZIndex="100" Background="#000000">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.08*" />
                <ColumnDefinition Width="0.92*" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Background="#000000">
                <local:SigilIntro x:Name="LoginSigil" Formed="LoginSigil_Formed" />
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="28,26,0,0">
                    <TextBlock Text="YNOEZ" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" />
                    <TextBlock Text="SYSTEM / PERFORMANCE" FontSize="8" Foreground="#666666" Margin="0,4,0,0" />
                </StackPanel>
                <TextBlock Text="CLIQUE NO SIGILO PARA PULAR A ANIMAÇÃO"
                           HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28"
                           FontSize="8" Foreground="#777777" />
            </Grid>
            <Border Grid.Column="1" BorderBrush="#222222" BorderThickness="1,0,0,0" Background="#050505">
                <Grid>
                    <StackPanel x:Name="LoginForm" Visibility="Collapsed" Opacity="0"
                                Width="300" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="ACESSO LOCAL" FontSize="10" FontWeight="Bold"
                                   Foreground="#FF80FF" Margin="0,0,0,12" />
                        <TextBlock Text="Bem-vindo ao ynoez" FontSize="26" FontWeight="SemiBold"
                                   Foreground="#FFFFFF" />
                        <TextBlock Text="Seu painel de controle para Windows, jogos e hardware."
                                   FontSize="11" Foreground="#999999" TextWrapping="Wrap"
                                   Margin="0,7,0,25" />
                        <TextBlock Text="USUÁRIO" FontSize="8" Foreground="#888888" Margin="0,0,0,6" />
                        <TextBox x:Name="LoginAccount" Height="38" Padding="10,8"
                                 Background="#111111" Foreground="#FFFFFF" BorderBrush="#383838"
                                 CaretBrush="#FFFFFF" FontSize="12" />
                        <TextBlock Text="SENHA" FontSize="8" Foreground="#888888" Margin="0,15,0,6" />
                        <PasswordBox x:Name="LoginPassword" Height="38" Padding="10,8"
                                     Background="#111111" Foreground="#FFFFFF" BorderBrush="#383838"
                                     FontSize="12" />
                        <Button Content="ENTRAR NO YNOEZ" Height="42" Margin="0,22,0,0"
                                Background="#3A173A" Foreground="#FFFFFF" BorderBrush="#FF80FF"
                                BorderThickness="1" FontWeight="Bold" Cursor="Hand" Click="Login_Click" />
                        <TextBlock Text="Modo demonstrativo local — não autentica nem transmite credenciais."
                                   FontSize="8" Foreground="#666666" TextWrapping="Wrap"
                                   Margin="0,18,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
